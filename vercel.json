{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/news/partnerstwo-z-wiodacym-producentem-lotniczym",
      "destination": "/news/jak-metalizacja-wplywa-na-wydajnosc-materialow",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }]
}
